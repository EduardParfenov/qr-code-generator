# Служебные файлы и данные, которые не должны попадать в контекст сборки и образ

# Git и CI
.git/
.github/

# Виртуальное окружение и кэши Python
.venv/
__pycache__/
.pytest_cache/

# Локальные настройки компании (не вшивать в образ — передаются через env_file)
.env

# Логи (в контейнере логи — только stdout)
logs/

# Вспомогательные данные проекта
input/

# Планирование и инструменты разработки
openspec/
.opencode/
