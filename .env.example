# Настройки приложения QR-code-generator.
# Скопируйте файл в .env (cp .env.example .env) и укажите данные вашей компании.
# Если .env отсутствует или переменная не задана — используются демо-значения ниже.

# Название организации (подставляется в должность контакта)
COMPANY_NAME=ООО "Рога и копыта"

# Сайт компании
COMPANY_SITE=roga-i-kopyta.com

# Адрес компании (рабочий адрес в vCard)
COMPANY_ADDRESS_STREET=ул. Рогов и копыт, 34
COMPANY_ADDRESS_CITY=Нью-Йорк
COMPANY_ADDRESS_REGION=Нью-Йорская область
COMPANY_ADDRESS_CODE=4444444
COMPANY_ADDRESS_COUNTRY=Россия

# Позиция QR-кода на фоне: доля от ширины/высоты фона, от 0 до 1.
# Дробная часть — через точку (0.055, а не 0,055).
QR_X_POS=0.055
QR_Y_POS=0.055

# Размер QR-кода: доля от высоты фона, от 0 до 1
QR_SIZE_RATIO=0.9

# Предзаполненные значения в полях формы:
# домен корпоративной почты (пользователь дописывает логин перед ним)
FORM_EMAIL_DEFAULT=@roga-i-kopyta.com
# шаблон рабочего телефона
FORM_WORK_PHONE_DEFAULT=+7(800)000-00-00
